# Copy to .env and fill in. Never commit the real .env.
# Backtest data comes from Interactive Brokers (paper gateway). No yfinance.

# IBKR connection (paper Gateway default = 4002; TWS paper = 7497)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=37

# Strategy defaults
ORDER_SIZE_USD=100000
LOOKBACK_DAYS=100
